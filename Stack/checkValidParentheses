
str1 = "()"
str2 = "()[]{}"
str3 = "(]"
str4 = "([])"
str5 = "([)]"
str6= "))}"

function checkValidParentheses(str) {
  let stack =[];
  for (let i=0; i<str.length; i++) {
    let char = str[i]
    if (char === '(' || char === '[' || char === '{') {
      stack.push(char)
    } else {
      let prevValue = stack[stack.length-1]
      if (prevValue === '(' && char !==')') return false;
      if (prevValue === '{' && char !=='}') return false;
      if (prevValue === '[' && char !==']') return false;
      if (prevValue === undefined) return false;  // because of str6 case
      stack.pop()
    }
  } 
  return (stack.length ===0)
}

